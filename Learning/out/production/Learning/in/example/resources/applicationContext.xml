<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean class="in.example.beans.Address" id="addrId">
        <constructor-arg value="34"/>
        <constructor-arg value="Bokaro"/>
        <constructor-arg value="829112"/>
    </bean>

    <bean class="in.example.beans.Student" id="stdId">
        <constructor-arg value="Abhijai"/>
        <constructor-arg value="3"/>
        <constructor-arg ref="addrId"/>
    </bean>

</beans>