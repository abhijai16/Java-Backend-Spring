<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean class="in.example.beans.Address" id="address">
        <property name="houseNo" value="80"/>
        <property name="city" value="Jamshedpur"/>
        <property name="pincode" value="999999"/>
    </bean>

    <bean class="in.example.beans.Student" id="stdId" autowire="byName">
        <property name="name" value="Divyansh"/>
        <property name="rollNo" value="12"/>
<!--        <property name="address" ref="addrId"/>  Manually Dependency Injection-->
    </bean>

</beans>