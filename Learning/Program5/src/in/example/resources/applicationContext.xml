<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean class="in.example.beans.Address" id="addrId">
        <property name="houseNo" value="33"/>
        <property name="city" value="Bokaro"/>
        <property name="pincode" value="829112"/>
    </bean>

    <bean class="in.example.beans.Student" id="stdId">
        <property name="name" value="Abhijai"/>
        <property name="rollNo" value="3"/>
        <property name="address" ref="addrId"/> <!--Here we will use ref attribute to inject address bean object here.-->
    </bean>

</beans>